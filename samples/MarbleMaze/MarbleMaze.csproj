<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The original project's graphics profile; CNA.XnaCompat.targets embeds it as XNA did. -->
    <XnaProfile>Reach</XnaProfile>
    <XnaPlatform>Windows Phone</XnaPlatform>
    <RootNamespace>MarbleMazeGame</RootNamespace>
    <AssemblyName>MarbleMazeGame</AssemblyName>
    <!-- Upstream ships only the phone project: TRACE;WINDOWS_PHONE, so its Main is guarded out. -->
    <CnaPhoneGame>MarbleMazeGame.MarbleMazeGame</CnaPhoneGame>
    <CnaPhoneCompat>true</CnaPhoneCompat>
    <!-- It calls the Guide without a GamerServicesComponent; the host adds one (Directory.Build.targets). -->
    <CnaPhoneGamerServices>true</CnaPhoneGamerServices>
  </PropertyGroup>
</Project>
