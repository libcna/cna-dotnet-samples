<Project Sdk="Microsoft.NET.Sdk">
  <!-- Two upstream source trees live side by side here, so default compile items are off. -->
  <PropertyGroup>
    <!-- The original project's graphics profile; CNA.XnaCompat.targets embeds it as XNA did. -->
    <XnaProfile>Reach</XnaProfile>
    <XnaPlatform>Windows Phone</XnaPlatform>
    <RootNamespace>NinjAcademy</RootNamespace>
    <AssemblyName>NinjAcademy</AssemblyName>
    <!-- Upstream ships only the phone project, and a phone game has no Main: the XAP host supplied it. -->
    <CnaPhoneGame>NinjAcademy.NinjAcademyGame</CnaPhoneGame>
    <CnaPhoneCompat>true</CnaPhoneCompat>
    <!-- It calls the Guide without a GamerServicesComponent; the host adds one (Directory.Build.targets). -->
    <CnaPhoneGamerServices>true</CnaPhoneGamerServices>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="NinjAcademy/**/*.cs" />
    <ProjectReference Include="NinjAcademyCommonTypes.csproj" />
  </ItemGroup>
</Project>
